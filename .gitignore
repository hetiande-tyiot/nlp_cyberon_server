# ===== Python 虛擬環境 (1.5G) =====
# venv 必須在目標機器重建，不能複製
llmenv/
venv/
.venv/

# ===== 整包走 rsync 的模型資料夾（不進 git，以資料夾為單位）=====
# 這些資料夾是純模型，視為一個整體用 rsync 傳，不在內部分裂。
models/
# BERT 模型：無後綴原檔案夾 = 當前正式模型（其 config/label_map 進 git 追蹤類別結構）；
# 帶後綴 _* 的 = 備份/版本/過渡目錄（_bak_日期 / _v2 / _v5 / _new_2…），整個排除。
# 權重檔（model.safetensors / pytorch_model.bin）另由下方權重副檔名排除、走 rsync。
ai/TW-119-BERT-sub_*_*/
ai/TW-119-BERT_main_*/

# ===== 權重副檔名（安全網）=====
# STT-Whisper 為例外：server 程式與 config 進 git，只有 model.bin 被這裡擋掉走 rsync。
*.gguf
*.safetensors
*.bin
*.pt
*.pth
*.onnx
*.ckpt

# ===== 機密檔案 =====
# 憑證 / 金鑰絕對不要進 git
*.pem
*.key
*.crt
.env
.env.*
!.env.example

# ===== Python 快取 =====
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ===== Go =====
vendor/

# ===== Log / 暫存 =====
*.log
log_119/
*.zip
*.tmp

# ===== 音檔 (測試資料，如果要傳就把這段刪掉) =====
*.wav
*.pcm8

# ===== 編輯器 / OS =====
.vscode/
.idea/
.DS_Store
Thumbs.db
.claude/settings.local.json

# ===== AI 工具本地設定 =====
.claude/skills/
.agents/

# ===== 測試/部署工具 =====
deploy_nlp_model.sh
# llama-server binary（258MB，從 204 rsync 過來，不進 repo）
llama-server-sm120/
