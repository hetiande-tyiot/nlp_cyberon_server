# 測試環境（SOP 調整用）的 119 服務：port 8300，程式在 sop_1008 分支的 ai/119_1008_SOP。
# 模型走 GPU1 的 llama-server-gpu1（8093）；案件 json 寫到 log_119_test，不跟正式的 log_119 混在一起。
# __ADDRCHECK_TOKEN__ 是佔位字，安裝時從正式的 sop119.service 帶入，密碼不進 git。
[Unit]
Description=119 SOP LLM API 測試環境（port 8300）
After=network.target llama-server-gpu1.service
Requires=llama-server-gpu1.service

[Service]
User=taiyan
Group=taiyan
WorkingDirectory=/home/taiyan/project/nlp_cyberon_server_sop1008/ai/119_1008_SOP
Environment=PYTHONUNBUFFERED=1
Environment=GGUF_MODEL_PATH=/home/taiyan/project/nlp_cyberon_server/models/TW-119-Model.gguf
Environment=BERT_MODELS_BASE=/home/taiyan/project/nlp_cyberon_server/ai/
Environment=LOG_DIR=/home/taiyan/project/nlp_cyberon_server/log_119_test
Environment=BERT_DEVICE=cpu
Environment=ADDRCHECK_API_URL=http://100.107.145.7:8088
Environment=ADDRCHECK_API_TOKEN=__ADDRCHECK_TOKEN__
Environment=ADDRCHECK_API_TIMEOUT=2.5
Environment=LLM_BACKEND=llama-server
Environment=LLAMA_SERVER_URL=http://127.0.0.1:8093
Environment=LLAMA_SERVER_MODEL=tw-119-model
Environment=LLAMA_SERVER_TIMEOUT=180
ExecStartPre=/home/taiyan/project/nlp_cyberon_server/wait_llama.sh 8093
ExecStart=/home/taiyan/project/nlp_cyberon_server/llmenv/bin/uvicorn sop_api_server:app --host 0.0.0.0 --port 8300
Restart=on-failure
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
